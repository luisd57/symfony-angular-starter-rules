###> symfony/framework-bundle ###
APP_ENV=dev
# Generate per project - never reuse a value from another repo:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CHANGE_ME
# Comma-separated list of trusted proxy IPs. Use REMOTE_ADDR for Docker/single-proxy setups.
TRUSTED_PROXIES=REMOTE_ADDR
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Credentials must match the postgres service in docker-compose.yml
DATABASE_URL="postgresql://{{project}}_user:CHANGE_ME@postgres:5432/{{project}}_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
# Keys are gitignored - generate them with:
#   php bin/console lexik:jwt:generate-keypair --skip-if-exists --no-interaction
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Must match the passphrase used at keypair generation. Generate per project.
JWT_PASSPHRASE=CHANGE_ME
JWT_TOKEN_TTL=3600
# Must be true in production (HTTPS only).
JWT_COOKIE_SECURE=false
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailhog:1025
###< symfony/mailer ###

###> redis ###
# Password must match the redis service in docker-compose.yml
REDIS_URL=redis://:CHANGE_ME@redis:6379
###< redis ###

###> app ###
APP_FRONTEND_URL=http://localhost:4321
# {{FILL: one line per domain TTL / tunable, mirrored in config/services.yaml parameters}}
###< app ###

###> symfony/routing ###
# Used when generating URLs outside an HTTP context, such as CLI commands.
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
