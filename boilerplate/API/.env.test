# .env.test — test environment overrides.
#
# This file IS committed, so it must never hold a value that also protects
# anything real. Generate throwaway values per project.
APP_ENV=test
APP_SECRET=CHANGE_ME_TEST_ONLY
TRUSTED_PROXIES=REMOTE_ADDR

# Same host as dev; doctrine.yaml appends the _test suffix automatically.
DATABASE_URL="postgresql://{{project}}_user:CHANGE_ME@postgres:5432/{{project}}_db?serverVersion=16&charset=utf8"

# Reuse the dev keypair — these are local-only keys, never production ones.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME
JWT_TOKEN_TTL=3600

# Null transport: the suite must never send a real email.
MAILER_DSN=null://null

APP_FRONTEND_URL=http://localhost:4321
# {{FILL: domain TTLs the test suite depends on}}
